# Copy this file to .env.local and fill in the values.
# Everything starting with NEXT_PUBLIC_ is visible in the browser, so only public values go here.

# Your Supabase project's API URL and PUBLISHABLE key (Project Settings -> API Keys).
# For local development with `npx supabase start`, use the values printed by `npx supabase status`
# (API URL http://127.0.0.1:54321 and the local publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://yhbeantyuxslcsgdiujh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The address people use to reach the site. Used in email links and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the Supabase secret / service-role key here or anywhere in the app.
